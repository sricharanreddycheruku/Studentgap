# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL:  postgresql://postgres:password@localhost:5432/classpulse
# Free cloud option: get a free DB at neon.tech → copy the connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Get a free key at aistudio.google.com → "Get API key"
GEMINI_API_KEY=your-gemini-api-key

# ─── WhatsApp (Green API) ─────────────────────────────────────────────────────
# Sign up free at green-api.com → create an instance → scan QR with your WhatsApp
GREENAPI_INSTANCE_ID=your-instance-id
GREENAPI_API_TOKEN=your-api-token

# Set to "true" to skip real WhatsApp and just log messages (good for local testing)
USE_MOCK_WHATSAPP=false

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=3000
